# Godown Ledger settings.
# Copy this file to ".env" and fill in your own values. Never commit ".env".
# On a host (Vercel, Render, Railway), add these as environment variables instead of uploading ".env".
#
# Put comments on their own line: the server's .env reader does not strip comments after a value.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Keep the database name in the path ("/godown" below); without it the data goes into a database called "test".
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F.
# While "<db_password>" is still in this value, the server ignores it and the app uses browser-local storage.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/godown?retryWrites=true&w=majority

# Access keys: fill in your own long random texts, for example from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# owner: read, add, change and delete everything. Required once MONGODB_URI is filled in.
# While there is no database, an empty OWNER_KEY means the owner key is "local-owner" (for trying the app only).
OWNER_KEY=
# staff: read, and add new entries only. Leave empty to turn off staff access.
STAFF_KEY=
# view: read only. Leave empty to turn off viewer access.
VIEW_KEY=

# Port for "npm start" (optional, default 3000). Vercel ignores it.
PORT=3000
